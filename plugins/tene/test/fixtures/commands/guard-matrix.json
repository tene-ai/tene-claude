    { "cmd": "sudo tene get KEY", "rule": "SR1", "note": "래퍼" },
    { "cmd": "env tene get KEY", "rule": "SR1", "note": "래퍼" },
    { "cmd": "echo $(tene get KEY)", "rule": "SR1", "note": "명령 치환" },
    { "cmd": "ls; tene get KEY", "rule": "SR1", "note": "세미콜론" },
    { "cmd": "false || tene get KEY", "rule": "SR1", "note": "or 체인" },
    { "cmd": "/usr/local/bin/tene get KEY", "rule": "SR1", "note": "절대 경로" },
    { "cmd": "tene set STRIPE_KEY sk_live_abc123", "rule": "SR4" },
    { "cmd": "tene set DB_URL postgres://u:p@h/d", "rule": "SR4" }
